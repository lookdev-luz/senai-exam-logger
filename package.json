{
  "name": "senai-exam-logger",
  "displayName": "SENAI Exam Logger",
  "version": "1.0.0",
  "description": "Extensão privada para avaliações práticas de programação do SENAI.",
  "private": true,
  "publisher": "senai-private",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onCommand:senaiExamLogger.startExam",
    "onCommand:senaiExamLogger.finishExam",
    "onCommand:senaiExamLogger.status",
    "onCommand:senaiExamLogger.openLogs",
    "onCommand:senaiExamLogger.showLastReport",
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "senaiExamLogger.startExam",
        "title": "Iniciar Prova",
        "category": "SENAI Exam Logger"
      },
      {
        "command": "senaiExamLogger.finishExam",
        "title": "Finalizar Prova",
        "category": "SENAI Exam Logger"
      },
      {
        "command": "senaiExamLogger.status",
        "title": "Status",
        "category": "SENAI Exam Logger"
      },
      {
        "command": "senaiExamLogger.openLogs",
        "title": "Abrir Pasta de Logs",
        "category": "SENAI Exam Logger"
      },
      {
        "command": "senaiExamLogger.showLastReport",
        "title": "Mostrar Relatório da Última Prova",
        "category": "SENAI Exam Logger"
      }
    ],
    "configuration": {
      "title": "SENAI Exam Logger",
      "properties": {
        "senaiExamLogger.bulkInsertCharacterThreshold": {
          "type": "number",
          "default": 100,
          "minimum": 1,
          "description": "Quantidade mínima de caracteres em uma alteração para registrar BULK_INSERT."
        },
        "senaiExamLogger.bulkInsertLineThreshold": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "description": "Quantidade mínima de linhas inseridas em uma alteração para registrar BULK_INSERT."
        },
        "senaiExamLogger.internalCopySimilarityThreshold": {
          "type": "number", "default": 0.85, "minimum": 0, "maximum": 1,
          "description": "Similaridade mínima para registrar uma possível origem em outro arquivo interno."
        },
        "senaiExamLogger.idleThresholdSeconds": {
          "type": "number", "default": 60, "minimum": 1,
          "description": "Segundos sem atividade observável no VS Code antes de registrar IDLE_STARTED."
        },
        "senaiExamLogger.maxStoredInsertedTextLength": {
          "type": "number", "default": 4096, "minimum": 0,
          "description": "Tamanho máximo do texto inserido armazenado integralmente por alteração."
        },
        "senaiExamLogger.snapshotOnBulkInsert": {
          "type": "boolean", "default": true,
          "description": "Cria snapshot após uma inserção em massa, ignorando conteúdo idêntico ao último snapshot."
        }
      }
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.js",
    "check": "tsc --noEmit",
    "typecheck": "npm run check",
    "test": "tsx --test test/*.test.ts",
    "lint": "tsc --noEmit",
    "package": "npm run build && vsce package --allow-missing-repository --out senai-exam-logger-${npm_package_version}.vsix",
    "watch": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.js --watch"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/vscode": "1.85.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "tsx": "^4.20.6",
    "@vscode/vsce": "^3.6.0"
  }
}
